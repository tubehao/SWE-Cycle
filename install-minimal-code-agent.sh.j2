#!/bin/bash
set -e
# Install MinimalCodeAgent dependencies

# Check that MinimalCodeAgent was uploaded
if [ ! -d /MinimalCodeAgent ]; then
    echo "ERROR: /MinimalCodeAgent directory not found. Did setup() upload it?"
    exit 1
fi

# System dependencies
apt-get update -qq && apt-get install -y -qq wget curl ca-certificates tmux lsof >/dev/null 2>&1
rm -rf /var/lib/apt/lists/*

# Install miniconda (if not present)
if [ ! -d /opt/miniconda3 ]; then
  wget -q 'https://repo.anaconda.com/miniconda/Miniconda3-py310_24.1.2-0-Linux-x86_64.sh' -O /tmp/miniconda.sh
  bash /tmp/miniconda.sh -b -p /opt/miniconda3
  rm /tmp/miniconda.sh
fi
export PATH=/opt/miniconda3/bin:$PATH

# Create conda environment + install dependencies
source /opt/miniconda3/etc/profile.d/conda.sh
conda create -n minimalcodeagent python=3.10 -y || true
conda activate minimalcodeagent

if [ -f /MinimalCodeAgent/requirements.txt ]; then
  pip install --no-cache-dir -r /MinimalCodeAgent/requirements.txt
fi

echo "MinimalCodeAgent setup complete"
